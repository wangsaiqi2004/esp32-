+/* ---------------------------------------------------------------------------
+ * Uplink captive-portal auto-login page (ePortal / Dr.COM).
+ * Kept self-contained: no shared page templates, so it cannot disturb the
+ * positional %s substitution used by the larger pages.
+ * ------------------------------------------------------------------------- */
+
+static void form_decode(const char *src, char *dst, size_t len)
+{
+    size_t o = 0;
+    for (size_t i = 0; src[i] && o + 1 < len; i++) {
+        if (src[i] == '%' && isxdigit((unsigned char)src[i + 1]) &&
+            isxdigit((unsigned char)src[i + 2])) {
+            char hex[3] = { src[i + 1], src[i + 2], '\0' };
+            dst[o++] = (char)strtol(hex, NULL, 16);
+            i += 2;
+        } else if (src[i] == '+') {
+            dst[o++] = ' ';
+        } else {
+            dst[o++] = src[i];
+        }
+    }
+    dst[o] = '\0';
+}
+
+static bool form_get(const char *body, const char *key, char *out, size_t len)
+{
+    size_t klen = strlen(key);
+    const char *p = body;
+    while (p && *p) {
+        if (strncmp(p, key, klen) == 0 && p[klen] == '=') {
+            const char *v = p + klen + 1;
+            const char *end = strchr(v, '&');
+            size_t n = end ? (size_t)(end - v) : strlen(v);
+            char tmp[256];
+            if (n >= sizeof(tmp)) n = sizeof(tmp) - 1;
+            memcpy(tmp, v, n);
+            tmp[n] = '\0';
+            form_decode(tmp, out, len);
+            return true;
+        }
+        p = strchr(p, '&');
+        if (p) p++;
+    }
+    return false;
+}
