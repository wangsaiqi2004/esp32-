+static esp_err_t portal_get_handler(httpd_req_t *req)
+{
+    /* Password protection, same policy as the other config pages. */
+    if (is_web_password_set() && !is_authenticated(req)) {
+        httpd_resp_set_status(req, "303 See Other");
+        httpd_resp_set_hdr(req, "Location", "/?auth_required=1");
+        httpd_resp_send(req, NULL, 0);
+        return ESP_OK;
+    }
+
+    char url[192] = "", user[64] = "", pass[64] = "";
+    int en = 0, iv = 240;
+    portal_config_get(url, sizeof(url), user, sizeof(user), pass, sizeof(pass), &en, &iv);
+
+    char status[192];
+    portal_status_text(status, sizeof(status));
+
+    /* url(192) + user(64) + status(192) + ~700 bytes of markup: keep it roomy
+     * so the compiler can prove there is no truncation. */
+    char row[2048];
+    snprintf(row, sizeof(row),
+        "<div class='st'>%s</div>"
+        "<form action='/portal' method='post'><table>"
+        "<tr><td style='width:44%%'>Enable auto-login</td>"
+        "<td><input type='checkbox' name='en' value='1' %s></td></tr>"
+        "<tr><td>Login URL base</td><td><input type='text' name='url' value='%s'></td></tr>"
+        "<tr><td>Username / student ID</td><td><input type='text' name='user' value='%s'></td></tr>"
+        "<tr><td>Password</td><td><input type='password' name='pass' value='' placeholder='%s'></td></tr>"
+        "<tr><td>Keepalive (sec)</td><td><input type='number' name='iv' value='%d' min='60' max='1800'></td></tr>"
+        "<tr><td></td><td><input type='submit' value='Save' class='ok'></td></tr>"
+        "</table></form>"
+        "<p><small>Checks real internet reachability and re-logs in when the uplink "
+        "session expires. Password is stored in NVS on the device.</small></p>"
+        "<p><a href='/'>Back to home</a></p>",
+        status, en ? "checked" : "", url, user,
+        pass[0] ? "saved - leave blank to keep" : "not set yet", iv);
+
+    httpd_resp_set_type(req, "text/html");
+    SEND_CHUNK(req, PORTAL_HEAD, HTTPD_RESP_USE_STRLEN);
+    SEND_CHUNK(req, row, HTTPD_RESP_USE_STRLEN);
+    SEND_CHUNK(req, NULL, 0);
+    return ESP_OK;
+}
+
+static esp_err_t portal_post_handler(httpd_req_t *req)
+{
+    if (is_web_password_set() && !is_authenticated(req)) {
+        httpd_resp_set_status(req, "303 See Other");
+        httpd_resp_set_hdr(req, "Location", "/?auth_required=1");
+        httpd_resp_send(req, NULL, 0);
+        return ESP_OK;
+    }
+
+    char body[512];
+    int total = 0, r;
+    while (total < (int)sizeof(body) - 1 &&
+           (r = httpd_req_recv(req, body + total, sizeof(body) - 1 - total)) > 0) {
+        total += r;
+    }
+    body[total] = '\0';
+
+    char en_s[8] = "", url[192] = "", user[64] = "", pass[64] = "", iv_s[8] = "";
+    form_get(body, "en", en_s, sizeof(en_s));
+    bool has_url  = form_get(body, "url", url, sizeof(url));
+    bool has_user = form_get(body, "user", user, sizeof(user));
+    bool has_pass = form_get(body, "pass", pass, sizeof(pass));
+    bool has_iv   = form_get(body, "iv", iv_s, sizeof(iv_s));
+
+    int en = (strcmp(en_s, "1") == 0) ? 1 : 0;
+    int iv = has_iv ? atoi(iv_s) : 240;
+
+    /* An empty password field means "keep the stored one". */
+    portal_config_set(has_url ? url : NULL,
+                      has_user ? user : NULL,
+                      (has_pass && pass[0] != '\0') ? pass : NULL,
+                      en, iv);
+
+    httpd_resp_set_status(req, "303 See Other");
+    httpd_resp_set_hdr(req, "Location", "/portal");
+    httpd_resp_send(req, NULL, 0);
+    return ESP_OK;
+}
